# Las credenciales y el registro SMTP no se sirven por HTTP.
# Los demás PHP del sitio siguen accesibles para los formularios.
<FilesMatch "^(config.*\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
