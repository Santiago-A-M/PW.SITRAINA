{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "msedge",
      "request": "launch",
      "name": "SITRAINA (local)",
      "url": "http://127.0.0.1:8765/index.html",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "preview-server",
      "runtimeArgs": [
        "--disable-http-cache"
      ]
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "SITRAINA (Chrome local)",
      "url": "http://127.0.0.1:8765/index.html",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "preview-server",
      "runtimeArgs": [
        "--disable-http-cache"
      ]
    }
  ]
}
